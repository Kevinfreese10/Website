rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdminOrStaff() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cap_staff' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cap_supervisor');
    }

    function hasModule(moduleName) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             'allowedModules' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
             moduleName in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.allowedModules;
    }

    /** True when the caller is an active staff member of the given partner */
    function isPartnerStaffOf(partnerId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partnerId == partnerId &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false;
    }

    /** True when the caller IS the partner (owner) */
    function isPartnerOwner(partnerId) {
      return isAuthenticated() && request.auth.uid == partnerId;
    }

    /** True when caller owns the data or is an active staff member of the owner */
    function isPartnerOrStaff(partnerId) {
      return isPartnerOwner(partnerId) || isPartnerStaffOf(partnerId);
    }

    /**
     * True when a self-write to /users/{userId} leaves every privilege-bearing field at its
     * existing value (comparing the resulting document to the current one, not just the keys
     * present in this write — so a merge-update of an unrelated field like "name" doesn't get
     * blocked just because the document already has, say, a "permissions" map on it).
     * "role" is the one exception: it may additionally be *set* to 'client' — the lowest-
     * privilege role — for normal signup. Any other role transition, and any change at all to
     * permissions/isActive/creditBalance/partnerSubscription/partnerTier/staffRole/partnerId,
     * must go through a server action using the Admin SDK, which can validate the transition.
     */
    function isSafeSelfWrite() {
      let after = request.resource.data;
      let before = resource != null ? resource.data : {};
      return after.get('permissions', null) == before.get('permissions', null) &&
             after.get('isActive', null) == before.get('isActive', null) &&
             after.get('creditBalance', null) == before.get('creditBalance', null) &&
             after.get('partnerSubscription', null) == before.get('partnerSubscription', null) &&
             after.get('partnerTier', null) == before.get('partnerTier', null) &&
             after.get('staffRole', null) == before.get('staffRole', null) &&
             after.get('partnerId', null) == before.get('partnerId', null) &&
             (after.get('role', null) == before.get('role', null) || after.get('role', null) == 'client');
    }

    /**
     * Prevents non-staff clients from modifying order status, assignedTo, total, checklist,
     * auditLog, fulfillmentStatus, documentUploads, or generatedDrafts directly.
     * Document uploads and status changes are processed securely via authenticated server actions.
     */
    function isSafeClientOrderUpdate() {
      let after = request.resource.data;
      let before = resource != null ? resource.data : {};
      return after.get('status', null) == before.get('status', null) &&
             after.get('fulfillmentStatus', null) == before.get('fulfillmentStatus', null) &&
             after.get('assignedTo', null) == before.get('assignedTo', null) &&
             after.get('department', null) == before.get('department', null) &&
             after.get('total', null) == before.get('total', null) &&
             after.get('items', null) == before.get('items', null) &&
             after.get('auditLog', null) == before.get('auditLog', null) &&
             after.get('checklist', null) == before.get('checklist', null) &&
             after.get('serviceSnapshots', null) == before.get('serviceSnapshots', null) &&
             after.get('documentUploads', null) == before.get('documentUploads', null) &&
             after.get('generatedDrafts', null) == before.get('generatedDrafts', null) &&
             // Money. `clientTotal` is what the PayFast webhook validates the paid amount
             // against, so leaving it writable let a client set their own price and pay it.
             after.get('clientTotal', null) == before.get('clientTotal', null) &&
             after.get('discountCode', null) == before.get('discountCode', null) &&
             after.get('discountAmount', null) == before.get('discountAmount', null) &&
             after.get('paymentMethod', null) == before.get('paymentMethod', null) &&
             // Order linkage. Server-side sync paths mirror data onto whatever order these
             // point at, so a client able to set them could overwrite an unrelated order.
             after.get('originalOrderId', null) == before.get('originalOrderId', null) &&
             after.get('parentOrderId', null) == before.get('parentOrderId', null) &&
             after.get('dependsOnOrderIds', null) == before.get('dependsOnOrderIds', null) &&
             after.get('blockedOrderIds', null) == before.get('blockedOrderIds', null) &&
             // Commercial ownership / routing.
             after.get('resellerId', null) == before.get('resellerId', null) &&
             after.get('partnerId', null) == before.get('partnerId', null) &&
             after.get('isOutsourced', null) == before.get('isOutsourced', null) &&
             after.get('documentContact', null) == before.get('documentContact', null);
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Scoped read access: self, admins/staff, partner practice owners & staff
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdminOrStaff() ||
        (resource != null && resource.data.get('partnerId', null) == request.auth.uid) ||
        isPartnerStaffOf(userId) ||
        resource == null
      );
      allow write: if isAuthenticated() && (
        (request.auth.uid == userId && isSafeSelfWrite()) ||
        isAdmin() ||
        // Partner owner can write to their staff member documents
        (resource != null && resource.data.get('partnerId', null) == request.auth.uid) ||
        (request.resource != null && request.resource.data.get('partnerId', null) == request.auth.uid)
      );
      match /serviceOverrides/{overrideId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isPartnerStaffOf(userId));
        // Write access handled exclusively by server actions using Admin SDK to enforce retail price floor
        allow write: if false;
      }
      match /walletLogs/{logId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ─── Partner Invites ─────────────────────────────────────────────────────
    // Doc ID = the invite token itself (UUID). Readable without auth so the
    // invite page can display the invite details before the staff member has an account.
    match /partnerInvites/{token} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.partnerId == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Only the invited user (accepting) or an admin can update
      allow update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Clients & Partners ──────────────────────────────────────────────────
    match /adminClients/{clientId} {
      allow read, write: if isAdminOrStaff();
    }

    // Partner clients — scoped to the owning partner and their active staff
    match /partnerClients/{clientId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isAdmin() ||
        request.auth.uid == clientId ||
        isPartnerOrStaff(resource.data.partnerId)
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isPartnerOrStaff(request.resource.data.partnerId)
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isPartnerOrStaff(resource.data.partnerId)
      );
      allow delete: if isAdmin() || isPartnerOwner(resource.data.partnerId);
    }

    match /aiPayrollClients/{clientId} {
      allow read: if isAuthenticated() && (
        isAdminOrStaff() ||
        request.auth.uid == clientId ||
        (resource != null && isPartnerOrStaff(resource.data.get('partnerId', '')))
      );
      allow write: if isAuthenticated() && (
        isAdminOrStaff() ||
        (request.resource != null && isPartnerOrStaff(request.resource.data.get('partnerId', ''))) ||
        (resource != null && isPartnerOrStaff(resource.data.get('partnerId', '')))
      );
      match /{document=**} {
        allow read, write: if isAuthenticated() && (
          isAdminOrStaff() ||
          request.auth.uid == clientId ||
          isPartnerOrStaff(get(/databases/$(database)/documents/aiPayrollClients/$(clientId)).data.get('partnerId', ''))
        );
      }
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated() && (
        isAdminOrStaff() ||
        request.auth.uid == clientId ||
        (resource != null && isPartnerOrStaff(resource.data.partnerId))
      );
      allow write: if isAuthenticated() && (
        isAdminOrStaff() ||
        request.auth.uid == clientId ||
        (resource != null && isPartnerOrStaff(resource.data.partnerId))
      );
    }

    // ─── Services ────────────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin() || hasModule('Manage Products');
    }

    // ─── Orders ──────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isAdminOrStaff() ||
        hasModule('Manage Orders') ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.resellerId ||
        (resource != null && 'partnerId' in resource.data && request.auth.uid == resource.data.partnerId) ||
        request.auth.uid == resource.data.clientId ||
        (resource != null && 'resellerId' in resource.data && isPartnerStaffOf(resource.data.resellerId)) ||
        (resource != null && 'partnerId' in resource.data && isPartnerStaffOf(resource.data.partnerId)) ||
        (request.auth.token.email != null && 'customerEmail' in resource.data && request.auth.token.email == resource.data.customerEmail) ||
        (request.auth.token.email != null && 'endCustomerEmail' in resource.data && request.auth.token.email == resource.data.endCustomerEmail)
      );
      // Order creation is handled securely via Server Actions (Firebase Admin SDK).
      // Direct client SDK creation is restricted to Admins/Staff.
      allow create: if isAuthenticated() && (isAdminOrStaff() || hasModule('Manage Orders'));
      allow update: if isAuthenticated() && (
        isAdminOrStaff() ||
        hasModule('Manage Orders') ||
        ((request.auth.uid == resource.data.userId ||
          request.auth.uid == resource.data.resellerId ||
          (resource != null && 'partnerId' in resource.data && request.auth.uid == resource.data.partnerId) ||
          request.auth.uid == resource.data.clientId ||
          (resource != null && 'resellerId' in resource.data && isPartnerStaffOf(resource.data.resellerId)) ||
          (resource != null && 'partnerId' in resource.data && isPartnerStaffOf(resource.data.partnerId)) ||
          (request.auth.token.email != null && 'customerEmail' in resource.data && request.auth.token.email == resource.data.customerEmail) ||
          (request.auth.token.email != null && 'endCustomerEmail' in resource.data && request.auth.token.email == resource.data.endCustomerEmail)) && isSafeClientOrderUpdate())
      );
      allow delete: if isAdmin();
    }

    // ─── Blog & Categories ────────────────────────────────────────────────────
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin() || hasModule('Manage Blog');
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || hasModule('Manage Categories');
    }

    // ─── Tasks ───────────────────────────────────────────────────────────────
    // Tasks are partner-scoped. Staff access depends on their permissions field,
    // which is enforced at the application layer (Firestore cannot read sub-fields
    // of the caller's own document in a rule without a get() call).
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isAdminOrStaff() ||
        request.auth.uid == resource.data.partnerId ||
        isPartnerStaffOf(resource.data.partnerId) ||
        // Legacy tasks without a partnerId (admin tasks)
        resource.data.partnerId == null ||
        !('partnerId' in resource.data)
      );
      allow create: if isAuthenticated() && (
        isAdminOrStaff() ||
        request.auth.uid == request.resource.data.partnerId ||
        isPartnerStaffOf(request.resource.data.partnerId)
      );
      allow update: if isAuthenticated() && (
        isAdminOrStaff() ||
        request.auth.uid == resource.data.get('partnerId', null) ||
        isPartnerStaffOf(resource.data.get('partnerId', null))
      );
      allow delete: if isAuthenticated() && (
        isAdminOrStaff() ||
        request.auth.uid == resource.data.partnerId
      );
    }

    // ─── Sequences ────────────────────────────────────────────────────────────
    // Locked down: sequences are managed only on the server side using the Firebase Admin SDK.
    match /sequences/{sequenceId} {
      allow read, write: if false;
    }

    // ─── Discounts ───────────────────────────────────────────────────────────
    match /discounts/{discountId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrStaff() || hasModule('Manage Discounts');
    }

    // ─── Compliance Requests ─────────────────────────────────────────────────
    match /complianceRequests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdminOrStaff() ||
        request.auth.uid == resource.data.userId ||
        isPartnerOrStaff(resource.data.partnerId)
      );
      allow write: if isAuthenticated() && (
        isAdminOrStaff() ||
        request.auth.uid == request.resource.data.userId ||
        isPartnerOrStaff(request.resource.data.partnerId)
      );
    }

    // ─── AI Accountant / Numera Clients ──────────────────────────────────────
    match /aiAccountantClients/{clientId} {
      allow read: if isAuthenticated() && (
        isAdminOrStaff() ||
        request.auth.uid == clientId ||
        (resource != null && isPartnerOrStaff(resource.data.partnerId))
      );
      allow write: if isAuthenticated() && (
        isAdminOrStaff() ||
        (request.resource != null && isPartnerOrStaff(request.resource.data.partnerId)) ||
        (resource != null && isPartnerOrStaff(resource.data.partnerId))
      );
      match /{document=**} {
        allow read, write: if isAuthenticated() && (
          isAdminOrStaff() ||
          request.auth.uid == clientId ||
          isPartnerOrStaff(get(/databases/$(database)/documents/aiAccountantClients/$(clientId)).data.partnerId)
        );
      }
    }

    match /numeraClients/{clientId} {
      allow read: if isAuthenticated() && (
        isAdminOrStaff() ||
        request.auth.uid == clientId ||
        (resource != null && isPartnerOrStaff(resource.data.partnerId))
      );
      allow write: if isAuthenticated() && (
        isAdminOrStaff() ||
        (request.resource != null && isPartnerOrStaff(request.resource.data.partnerId)) ||
        (resource != null && isPartnerOrStaff(resource.data.partnerId))
      );
      match /{document=**} {
        allow read, write: if isAuthenticated() && (
          isAdminOrStaff() ||
          request.auth.uid == clientId ||
          isPartnerOrStaff(get(/databases/$(database)/documents/numeraClients/$(clientId)).data.partnerId)
        );
      }
    }

    // ─── Extracted Invoices & Email Processing ────────────────────────────────
    // Sensitive financial data — strictly admin/staff or owning partner
    match /extractedInvoices/{invoiceId} {
      allow read, write: if isAdminOrStaff();
    }

    match /processedEmails/{emailId} {
      allow read, write: if isAdminOrStaff();
    }

    match /inboxEmails/{emailId} {
      allow read, write: if isAdminOrStaff();
    }

    // ─── Allocation Rules ─────────────────────────────────────────────────────
    match /allocationRules/{ruleId} {
      allow read, write: if isAdminOrStaff();
    }

    // ─── Unanswered Questions ─────────────────────────────────────────────────
    match /unansweredQuestions/{questionId} {
      allow read, write: if isAdminOrStaff();
    }

    // ─── Leads ────────────────────────────────────────────────────────────────
    match /cvLeads/{leadId} {
      allow read: if isAdminOrStaff();
      allow create: if true;
      allow update, delete: if isAdminOrStaff();
    }

    match /demoLeads/{leadId} {
      allow read: if isAdminOrStaff();
      allow create: if true;
      allow update, delete: if isAdminOrStaff();
    }

    match /partnerLeads/{leadId} {
      allow read: if isAuthenticated() && (resource.data.partnerId == request.auth.uid || isAdmin());
      allow create: if true;
      allow update, delete: if isAdminOrStaff();
    }

    // ─── Jobs ─────────────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.postedByUserId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.postedByUserId == request.auth.uid || isAdmin());
    }

    // ─── Chatbot ──────────────────────────────────────────────────────────────
    match /chatbotConversations/{conversationId} {
      allow get, create, update: if true;
      allow list, delete: if isAdmin();
    }

    // ─── Q&A Community (CAP) ──────────────────────────────────────────────────
    match /communityQuestions/{questionId} {
      allow read: if isAuthenticated() || resource.data.status == 'approved';
      
      allow create: if isAuthenticated() && 
        request.resource.data.authorId == request.auth.uid;

      allow update: if isAuthenticated() && (
        // Question author updating content
        (resource.data.authorId == request.auth.uid && request.resource.data.authorId == request.auth.uid) ||
        // User liking/unliking (limit changes only to likedBy and likesCount)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likesCount'])) ||
        // Question author marking solved
        (resource.data.authorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSolved', 'solvedAnswerId']))
      );
      
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);

      // Answers Subcollection
      match /answers/{answerId} {
        allow read: if isAuthenticated();
        
        allow create: if isAuthenticated() && 
          request.resource.data.authorId == request.auth.uid;

        allow update: if isAuthenticated() && (
          (resource.data.authorId == request.auth.uid) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likesCount'])) ||
          // Validate that the user editing isCorrect is indeed the author of the parent question
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCorrect']) && 
           get(/databases/$(database)/documents/communityQuestions/$(questionId)).data.authorId == request.auth.uid)
        );
        
        allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      }
    }

    // ─── Commissions & Data (CAP) ─────────────────────────────────────────────
    match /commissionData/{docId} {
      allow read, write: if isAdminOrStaff();
    }

    match /commissions/{commissionId} {
      allow read: if isAuthenticated() && (isAdminOrStaff() || request.auth.uid == resource.data.partnerId);
      allow write: if isAdminOrStaff();
    }

    // ─── Partner Refunds ──────────────────────────────────────────────────────
    // Created by admin when processing a wallet refund for R4,950 partners opting out
    match /partnerRefunds/{refundId} {
      allow read: if isAdmin() || request.auth.uid == resource.data.partnerId;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ─── SEO, Media, Knowledgebase ────────────────────────────────────────────
    match /staticSeo/{pageId} {
      allow read: if true;
      allow write: if isAdmin() || hasModule('Pages');
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin() || hasModule('Media');
    }

    match /knowledgeBase/{kbId} {
      allow read: if true;
      allow write: if isAdmin() || hasModule('Knowledge Base');
    }

    // ─── Email Inbox ──────────────────────────────────────────────────────
    match /emails/{emailId} {
      allow read, write: if isAdminOrStaff();
    }

    match /emailSettings/{settingId} {
      allow read, write: if isAdminOrStaff();
    }

    // ─── Custom Domains ──────────────────────────────────────────────────────
    // Publicly readable so edge middleware can perform fast domain lookups
    // Write access is handled exclusively by server actions using Admin SDK
    match /domainMappings/{domain} {
      allow read: if true;
      allow write: if false;
    }

    // ─── System Settings ──────────────────────────────────────────────────────
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

