rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (resource != null && resource.data.partnerId == request.auth.uid)
      );
      // Allow write if:
      // 1. User is updating their own profile
      // 2. Requester is an admin
      // 3. Requester is a partner and the target user belongs to their practice (matching partnerId)
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (resource != null && resource.data.partnerId == request.auth.uid) ||
        (request.resource != null && request.resource.data.partnerId == request.auth.uid)
      );
    }
    match /adminClients/{clientId} {
      allow read, write: if request.auth != null; 
    }
    match /partnerClients/{clientId} {
      allow read, write: if request.auth != null; 
    }
    match /aiPayrollClients/{clientId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /clients/{clientId} {
      allow read, write: if request.auth != null; 
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; 
    }
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.resellerId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create: if true && (
        request.resource.data.status == 'Pending Payment' ||
        (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (resource != null && resource.data.resellerId == request.auth.uid)
      );
      allow delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }
    match /sequences/{sequenceId} {
      allow read, write: if true;
    }
     match /discounts/{discountId} {
      allow read, write: if request.auth != null;
    }
     match /complianceRequests/{requestId} {
      allow read, write: if request.auth != null;
    }
    match /aiAccountantClients/{clientId}/{document=**} {
      allow read, write: if request.auth != null;
    }
     match /numeraClients/{clientId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /extractedInvoices/{invoiceId} {
      allow read, write: if request.auth != null;
    }
     match /processedEmails/{emailId} {
      allow read, write: if request.auth != null;
    }
    match /allocationRules/{ruleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; 
    }
    match /unansweredQuestions/{questionId} {
      allow read, write: if request.auth != null;
    }
    match /cvLeads/{leadId} {
      allow read: if request.auth != null;
      allow write: if true; 
    }
    match /demoLeads/{leadId} {
      allow read: if request.auth != null;
      allow write: if true; 
    }
    match /chatbotConversations/{conversationId} {
      allow get, create, update: if true;
      allow list, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
